# ========================================================
# Frontend Environment Variables (Exposed to browser via Vite)
# MUST ONLY contain public/anon keys - NEVER put service_role here!
# ========================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
VITE_APP_NAME="JMC Blood Bond - যশোর মেডিকেল কলেজ"

# ========================================================
# Cloudflare Pages Functions / Backend Secrets
# Configure these in Cloudflare Dashboard -> Pages -> Settings -> Environment variables
# OR via: wrangler pages secret put <KEY_NAME>
# ========================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni... (RESTRICTED SERVER-SIDE ONLY)
# CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAA... (Cloudflare Turnstile secret)
# CRON_SECRET=super-secret-cron-token-to-prevent-unauthorized-calls

